rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common security helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isStephen() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'stephencat.madhouse@gmail.com')
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? getUserData().role
        : (isStephen() ? 'admin' : 'viewer');
    }

    function getUserStatus() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? (getUserData().status == null ? 'active' : getUserData().status)
        : (isStephen() ? 'active' : 'pending');
    }

    function isAdmin() {
      return isSignedIn() && (
        isStephen() ||
        (getUserRole() == 'admin' && getUserStatus() == 'active')
      );
    }

    function isManager() {
      return isSignedIn() && (
        isAdmin() ||
        (getUserRole() in ['manager', 'director'] && getUserStatus() == 'active')
      );
    }

    // Staff level = authorized internal team that may edit operational records
    function isStaff() {
      return isSignedIn() && (
        isManager() ||
        (getUserRole() in ['staff', 'engineer', 'production', 'construction_manager', 'quality'] && getUserStatus() == 'active')
      );
    }

    // INTERNAL = any active internal role (incl. internal read-only viewers)
    function isInternal() {
      return isSignedIn() && (
        isStaff() ||
        (getUserRole() == 'viewer' && getUserStatus() == 'active')
      );
    }

    // EXTERNAL = Executive & Client Portal roles. They can read ONLY the
    // `portal` collection (sanitized, published content) and their own profile.
    function isExternal() {
      return isSignedIn() && getUserStatus() == 'active' &&
        getUserRole() in ['owner', 'executive', 'client', 'stakeholder'];
    }

    // Project Owner and Executives: client-facing dashboard + approved documents
    function isPortalDocumentReader() {
      return isSignedIn() && getUserStatus() == 'active' && getUserRole() in ['owner', 'executive'];
    }

    // --- USERS COLLECTION ---
    // Only admin can read or write the users collection and change roles.
    // Self-registration: bootstrap Stephen as 'admin', anyone else is 'pending'.
    // User can NEVER change their own role.
    match /users/{userId} {
      // Admins can list and read all users. A user can read their own profile to get their role.
      allow get: if isCurrentUser(userId) || isAdmin();
      allow list: if isAdmin();

      // Registration: User creates their own document on sign-up.
      // Stephen gets 'admin'. All other users get 'pending'.
      allow create: if isCurrentUser(userId) && (
        (isStephen() && incoming().role == 'admin') ||
        (!isStephen() && incoming().role == 'pending')
      ) && incoming().uid == userId;

      // Role changes: Only admin can update users, and a user can NEVER change their own role.
      allow update: if isAdmin() && request.auth.uid != userId && (
        (!incoming().diff(existing()).affectedKeys().hasAny(['role']) ||
         incoming().role in ['admin', 'director', 'manager', 'construction_manager', 'engineer', 'production', 'quality', 'staff', 'viewer',
                             'owner', 'executive', 'client', 'stakeholder', 'pending'])
      );

      // Deletion: Only admin can delete a user, cannot delete self.
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // --- MILESTONES ---
    // Anyone (including unauthenticated viewers) can READ.
    // Only admin can delete; admin and manager can create/update all fields.
    // Staff can only update status, updatedAt, updatedBy, and notes.
    match /milestones/{milestoneId} {
      allow read: if isInternal();
      allow create: if isManager();
      allow delete: if isAdmin();
      allow update: if isManager() || (
        isStaff() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy', 'notes'])
      );
    }

    // --- SCOPES ---
    match /scopes/{scopeId} {
      allow read: if isInternal();
      allow create: if isManager();
      allow delete: if isAdmin();
      allow update: if isManager() || (
        isStaff() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'percentComplete', 'subNote', 'updatedAt', 'updatedBy', 'status',
          'dateText', 'workingDays', 'leftPct', 'widthPct', 'name'
        ])
      );
    }

    // --- CONCRETE POURS ---
    match /pours/{pourId} {
      allow read: if isInternal();
      allow create: if isManager();
      allow delete: if isAdmin();
      allow update: if isManager() || (
        isStaff() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['prepStatus', 'pourStatus', 'cureStatus', 'inspStatus', 'milestoneStatus', 'remarks', 'updatedAt', 'updatedBy'])
      );
    }

    // --- PRODUCTION EPISODES ---
    match /episodes/{episodeId} {
      allow read: if isInternal();
      allow create: if isManager();
      allow delete: if isAdmin();
      allow update: if isManager() || (
        isStaff() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'scopeStatus', 'remarks', 'updatedAt', 'updatedBy'])
      );
    }

    // --- ACTIVITIES ---
    match /activities/{activityId} {
      allow read: if isInternal();
      allow create: if isManager();
      allow delete: if isAdmin();
      allow update: if isManager() || (
        isStaff() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt', 'updatedBy'])
      );
    }

    // --- CHARACTERS ---
    match /characters/{characterId} {
      allow read: if isInternal();
      allow create, update: if isManager();
      allow delete: if isAdmin();
    }

    // --- OVERRIDES ---
    match /overrides/{overrideKey} {
      allow read: if isInternal();
      allow write: if isStaff();
    }

    // --- SETTINGS ---
    match /settings/{settingsId} {
      allow read: if isInternal();
      allow write: if isManager();
    }

    // --- COMMAND CENTER: WEEKLY & MONTHLY REPORTS ---
    // Draft reports can be edited by Managers. Once a report is approved it is
    // locked: it can no longer be updated or deleted, so historical reports
    // cannot be changed silently.
    match /reports/{reportId} {
      allow read: if isInternal();
      allow create: if isStaff() && isValidId(reportId) && incoming().id == reportId
        && incoming().type in ['weekly', 'monthly']
        && incoming().status in ['draft', 'review'];
      // Drafts / reports under review: staff may edit and submit; only managers approve.
      allow update: if isStaff() && existing().status in ['draft', 'review']
        && incoming().id == existing().id && incoming().type == existing().type
        && (incoming().status in ['draft', 'review'] || (isManager() && incoming().status == 'approved'));
      // Approved / published reports are frozen: only the publishing status may change.
      allow update: if isManager() && existing().status in ['approved', 'published', 'archived']
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'publishedAt', 'publishedBy', 'archivedAt', 'archivedBy', 'updatedAt', 'updatedBy'])
        && incoming().status in ['approved', 'published', 'archived'];
      allow delete: if isAdmin() && existing().status in ['draft', 'review'];
    }

    // --- COMMAND CENTER: ISSUES, RISKS & DECISIONS LOG ---
    match /issues/{issueId} {
      allow read: if isInternal();
      allow create, update: if isStaff() && isValidId(issueId) && incoming().id == issueId
        && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 300;
      allow delete: if isAdmin();
    }

    // --- COMMAND CENTER: DAILY PROGRESS SNAPSHOTS (trend history) ---
    match /snapshots/{snapshotId} {
      allow read: if isInternal();
      allow create, update: if isStaff() && snapshotId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && incoming().actualPct is number && incoming().plannedPct is number;
      allow delete: if isAdmin();
    }

    // --- OPERATIONS: procurement & materials, manpower plans, document repository ---
    match /procurement/{id} {
      allow read: if isInternal();
      allow create, update: if isStaff() && isValidId(id) && incoming().id == id;
      allow delete: if isAdmin();
    }
    match /manpower/{id} {
      allow read: if isInternal();
      allow create, update: if isStaff() && isValidId(id) && incoming().id == id;
      allow delete: if isAdmin();
    }
    match /documents/{id} {
      allow read: if isInternal();
      allow create, update: if isStaff() && isValidId(id) && incoming().id == id;
      allow delete: if isAdmin();
    }

    // --- PUBLISHING: internal records prepared for the client portal ---
    match /publications/{id} {
      allow read: if isInternal();
      // Staff create drafts and submit for review; approval, publishing and archiving are manager-only.
      allow create: if isStaff() && isValidId(id) && incoming().id == id && incoming().status in ['draft', 'review'];
      allow update: if (isStaff() && existing().status in ['draft', 'review'] && incoming().status in ['draft', 'review'])
        || isManager();
      allow delete: if isAdmin();
    }

    // --- EXTERNAL PORTAL: sanitized, PUBLISHED content only ---
    // Public client-facing dashboard: anyone (no sign-in) may read published
    // records of the public kinds. Approved project documents ('document')
    // are readable only by the Project Owner, Executives and internal users.
    // Only Project Managers / Administrators publish (write).
    match /portal/{id} {
      allow read: if resource.data.kind in ['snapshot', 'report', 'photo', 'consideration', 'update', 'event']
        || isInternal() || isPortalDocumentReader()
        || (resource.data.kind == 'production' && isExternal());
      allow write: if isManager();
    }

    // --- PRODUCTION ALIGNMENT: production details for an existing episode (one document per episode ID) ---
    // The production team (staff) plans: classification, team, character availability, checklist, proposed dates.
    // Only directors / authorized managers confirm shoot dates, confirm the director and review construction changes.
    match /episodeProduction/{id} {
      function epValid() {
        return isValidId(id) && incoming().id == id;
      }
      function managerOnlyKeys() {
        return ['approval', 'directorConfirmed', 'alignedTo', 'reviewedAt', 'reviewedBy'];
      }
      allow read: if isInternal();
      allow create: if epValid() && (isManager() || (isStaff() && !incoming().keys().hasAny(managerOnlyKeys())));
      allow update: if epValid() && (isManager()
        || (isStaff() && !incoming().diff(existing()).affectedKeys().hasAny(managerOnlyKeys())));
      allow delete: if isManager();
    }

    // --- CALENDAR / PRODUCTION CALENDAR: one schedule (inspections, meetings, filming, milestones, announcements) ---
    // Managers create, edit, approve and publish. Staff (e.g. the production team) may PROPOSE events and edit
    // their own proposals until an administrator approves them; proposals can never be published.
    match /events/{id} {
      function evValid() {
        return isValidId(id) && incoming().id == id && incoming().date is string && incoming().title is string;
      }
      function evProposal() {
        return incoming().get('approval', '') == 'proposed' && incoming().get('published', false) == false
          && incoming().get('proposedById', '') == request.auth.uid;
      }
      allow read: if isInternal();
      allow create: if evValid() && (isManager() || (isStaff() && evProposal()));
      allow update: if evValid() && (isManager()
        || (isStaff() && existing().get('approval', '') == 'proposed' && existing().get('proposedById', '') == request.auth.uid && evProposal()));
      allow delete: if isManager()
        || (isStaff() && existing().get('approval', '') == 'proposed' && existing().get('proposedById', '') == request.auth.uid);
    }

    // --- DAILY SITE REPORTS (mobile site reporting) ---
    // Each person writes only their own reports; one document per person, date and activity.
    match /siteReports/{id} {
      allow read: if isInternal();
      allow create, update: if isStaff() && isValidId(id) && incoming().id == id
        && incoming().submittedById == request.auth.uid
        && incoming().progressAfter is number && incoming().progressAfter >= 0 && incoming().progressAfter <= 100;
      allow delete: if isAdmin();
    }

    // --- GOOGLE DRIVE FILE METADATA (binaries live in Google Drive) ---
    // Written by the server's Drive service (Admin SDK). In the app, managers may only
    // change the client-portal publication of a file; nobody can create or delete records.
    match /driveFiles/{id} {
      allow read: if isInternal();
      allow update: if isManager()
        && incoming().diff(existing()).affectedKeys().hasOnly(['publicationStatus', 'publishedAt', 'publishedBy'])
        && incoming().publicationStatus in ['internal', 'published'];
      allow create, delete: if false;
    }
    // Drive folder names (administrators) and the folder-ID cache (server only)
    match /driveConfig/{id} {
      allow read: if isInternal();
      allow write: if isAdmin() && id == 'settings';
    }

    // --- DAILY CONSTRUCTION REPORTS ---
    // Preparers create and edit their own reports until review; only managers review,
    // approve or return them. Submitting never approves a report.
    function drValid() {
      return incoming().status in ['draft', 'uploading', 'pending', 'submitted', 'under_review', 'approved', 'returned']
        && incoming().projectId is string && incoming().date is string && incoming().preparedById is string;
    }
    match /dailyReports/{id} {
      allow read: if isInternal();
      allow create: if isStaff() && isValidId(id) && incoming().id == id && drValid()
        && incoming().preparedById == request.auth.uid
        && incoming().status in ['draft', 'uploading', 'pending', 'submitted'];
      allow update: if drValid() && (
        (isStaff() && existing().preparedById == request.auth.uid
          && incoming().preparedById == existing().preparedById
          && incoming().get('review', null) == existing().get('review', null)
          && existing().status in ['draft', 'uploading', 'pending', 'submitted', 'returned']
          && (incoming().status in ['draft', 'uploading', 'pending', 'submitted']
            || (existing().status == 'returned' && incoming().status == 'returned')))
        || (isManager() && (existing().status != 'approved' || isAdmin()))
        // after approval a manager may only record that reported progress was applied to the tracker
        || (isManager() && existing().status == 'approved' && incoming().status == 'approved'
          && incoming().diff(existing()).affectedKeys().hasOnly(['activities', 'updatedAt', 'updatedBy'])
          && incoming().activities.size() == existing().activities.size())
      );
      allow delete: if isAdmin() || (isStaff() && existing().preparedById == request.auth.uid && existing().status == 'draft');
    }

    // --- AUTOMATED NARRATIVE REPORTS ---
    // Internal read. Staff create drafts (their own) and edit drafts; managers review, approve and
    // finalise. The generated original (`original`) can never change. Final reports are locked
    // except for administrators. Nothing here is visible to client roles.
    function nrValid() {
      return incoming().type in ['daily', 'weekly', 'monthly', 'milestone', 'activity', 'status', 'summary']
        && incoming().status in ['draft', 'review', 'approved', 'final']
        && incoming().periodStart is string && incoming().periodEnd is string
        && incoming().preparedById is string
        && incoming().sections is list && incoming().sections.size() <= 12
        && incoming().revisions is list && incoming().revisions.size() <= 200
        && incoming().original is map;
    }
    function nrUnchangedCore() {
      return incoming().id == existing().id
        && incoming().original == existing().original
        && incoming().preparedById == existing().preparedById
        && incoming().type == existing().type
        && incoming().periodStart == existing().periodStart
        && incoming().periodEnd == existing().periodEnd
        && incoming().createdAt == existing().createdAt;
    }
    match /narrativeReports/{id} {
      allow read: if isInternal();
      allow create: if isStaff() && isValidId(id) && incoming().id == id && nrValid()
        && incoming().preparedById == request.auth.uid && incoming().status == 'draft'
        && incoming().get('approvedBy', null) == null && incoming().get('finalizedBy', null) == null;
      allow update: if nrValid() && nrUnchangedCore() && (
        // staff: edit a draft and submit it for review (no approval fields)
        (isStaff() && existing().status == 'draft' && incoming().status in ['draft', 'review']
          && incoming().get('approvedBy', null) == existing().get('approvedBy', null)
          && incoming().get('finalizedBy', null) == existing().get('finalizedBy', null))
        // managers: review, approve, return, finalise — a final report is locked
        || (isManager() && existing().status != 'final')
        || isAdmin()
      );
      allow delete: if isAdmin() || (isStaff() && existing().preparedById == request.auth.uid && existing().status == 'draft');
    }
    match /narrativeConfig/{id} {
      allow read: if isInternal();
      allow write: if isManager() && id == 'schedule';
    }

    // --- CLIENT EXPERIENCE CONFIGURATION: construction journey stages, project profile ---
    // Internal only. Clients see this information only through the published `portal` snapshot.
    match /clientConfig/{id} {
      allow read: if isInternal();
      allow write: if isManager() && id in ['journey', 'profile'];
    }

    // --- PER-USER NOTIFICATION STATE: read keys + preferences, own document only ---
    match /userPrefs/{uid} {
      allow read: if isCurrentUser(uid) && isInternal();
      allow create, update: if isCurrentUser(uid) && isInternal()
        && incoming().readKeys is list && incoming().readKeys.size() <= 1000;
    }

    // --- AUDIT LOGS ---
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
