rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common security helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isStephen() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'stephencat.madhouse@gmail.com')
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? getUserData().role
        : (isStephen() ? 'admin' : 'viewer');
    }

    function getUserStatus() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? (getUserData().status == null ? 'active' : getUserData().status)
        : (isStephen() ? 'active' : 'pending');
    }

    function isAdmin() {
      return isSignedIn() && (
        isStephen() ||
        (getUserRole() == 'admin' && getUserStatus() == 'active')
      );
    }

    function isManager() {
      return isSignedIn() && (
        isAdmin() ||
        (getUserRole() == 'manager' && getUserStatus() == 'active')
      );
    }

    // Staff level = authorized internal team that may edit operational records
    function isStaff() {
      return isSignedIn() && (
        isManager() ||
        (getUserRole() in ['staff', 'engineer', 'production'] && getUserStatus() == 'active')
      );
    }

    // INTERNAL = any active internal role (incl. internal read-only viewers)
    function isInternal() {
      return isSignedIn() && (
        isStaff() ||
        (getUserRole() == 'viewer' && getUserStatus() == 'active')
      );
    }

    // EXTERNAL = Executive & Client Portal roles. They can read ONLY the
    // `portal` collection (sanitized, published content) and their own profile.
    function isExternal() {
      return isSignedIn() && getUserStatus() == 'active' &&
        getUserRole() in ['owner', 'executive', 'client', 'stakeholder'];
    }

    // --- USERS COLLECTION ---
    // Only admin can read or write the users collection and change roles.
    // Self-registration: bootstrap Stephen as 'admin', anyone else is 'pending'.
    // User can NEVER change their own role.
    match /users/{userId} {
      // Admins can list and read all users. A user can read their own profile to get their role.
      allow get: if isCurrentUser(userId) || isAdmin();
      allow list: if isAdmin();

      // Registration: User creates their own document on sign-up.
      // Stephen gets 'admin'. All other users get 'pending'.
      allow create: if isCurrentUser(userId) && (
        (isStephen() && incoming().role == 'admin') ||
        (!isStephen() && incoming().role == 'pending')
      ) && incoming().uid == userId;

      // Role changes: Only admin can update users, and a user can NEVER change their own role.
      allow update: if isAdmin() && request.auth.uid != userId && (
        (!incoming().diff(existing()).affectedKeys().hasAny(['role']) ||
         incoming().role in ['admin', 'manager', 'engineer', 'production', 'staff', 'viewer',
                             'owner', 'executive', 'client', 'stakeholder', 'pending'])
      );

      // Deletion: Only admin can delete a user, cannot delete self.
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // --- MILESTONES ---
    // Anyone (including unauthenticated viewers) can READ.
    // Only admin can delete; admin and manager can create/update all fields.
    // Staff can only update status, updatedAt, updatedBy, and notes.
    match /milestones/{milestoneId} {
      allow read: if isInternal();
      allow create: if isManager();
      allow delete: if isAdmin();
      allow update: if isManager() || (
        isStaff() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy', 'notes'])
      );
    }

    // --- SCOPES ---
    match /scopes/{scopeId} {
      allow read: if isInternal();
      allow create: if isManager();
      allow delete: if isAdmin();
      allow update: if isManager() || (
        isStaff() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'percentComplete', 'subNote', 'updatedAt', 'updatedBy', 'status',
          'dateText', 'workingDays', 'leftPct', 'widthPct', 'name'
        ])
      );
    }

    // --- CONCRETE POURS ---
    match /pours/{pourId} {
      allow read: if isInternal();
      allow create: if isManager();
      allow delete: if isAdmin();
      allow update: if isManager() || (
        isStaff() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['prepStatus', 'pourStatus', 'cureStatus', 'inspStatus', 'milestoneStatus', 'remarks', 'updatedAt', 'updatedBy'])
      );
    }

    // --- PRODUCTION EPISODES ---
    match /episodes/{episodeId} {
      allow read: if isInternal();
      allow create: if isManager();
      allow delete: if isAdmin();
      allow update: if isManager() || (
        isStaff() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'scopeStatus', 'remarks', 'updatedAt', 'updatedBy'])
      );
    }

    // --- ACTIVITIES ---
    match /activities/{activityId} {
      allow read: if isInternal();
      allow create: if isManager();
      allow delete: if isAdmin();
      allow update: if isManager() || (
        isStaff() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt', 'updatedBy'])
      );
    }

    // --- CHARACTERS ---
    match /characters/{characterId} {
      allow read: if isInternal();
      allow create, update: if isManager();
      allow delete: if isAdmin();
    }

    // --- OVERRIDES ---
    match /overrides/{overrideKey} {
      allow read: if isInternal();
      allow write: if isStaff();
    }

    // --- SETTINGS ---
    match /settings/{settingsId} {
      allow read: if isInternal();
      allow write: if isManager();
    }

    // --- COMMAND CENTER: WEEKLY & MONTHLY REPORTS ---
    // Draft reports can be edited by Managers. Once a report is approved it is
    // locked: it can no longer be updated or deleted, so historical reports
    // cannot be changed silently.
    match /reports/{reportId} {
      allow read: if isInternal();
      allow create: if isStaff() && isValidId(reportId) && incoming().id == reportId
        && incoming().type in ['weekly', 'monthly']
        && incoming().status in ['draft', 'review'];
      // Drafts / reports under review: staff may edit and submit; only managers approve.
      allow update: if isStaff() && existing().status in ['draft', 'review']
        && incoming().id == existing().id && incoming().type == existing().type
        && (incoming().status in ['draft', 'review'] || (isManager() && incoming().status == 'approved'));
      // Approved / published reports are frozen: only the publishing status may change.
      allow update: if isManager() && existing().status in ['approved', 'published', 'archived']
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'publishedAt', 'publishedBy', 'archivedAt', 'archivedBy', 'updatedAt', 'updatedBy'])
        && incoming().status in ['approved', 'published', 'archived'];
      allow delete: if isAdmin() && existing().status in ['draft', 'review'];
    }

    // --- COMMAND CENTER: ISSUES, RISKS & DECISIONS LOG ---
    match /issues/{issueId} {
      allow read: if isInternal();
      allow create, update: if isStaff() && isValidId(issueId) && incoming().id == issueId
        && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 300;
      allow delete: if isAdmin();
    }

    // --- COMMAND CENTER: DAILY PROGRESS SNAPSHOTS (trend history) ---
    match /snapshots/{snapshotId} {
      allow read: if isInternal();
      allow create, update: if isStaff() && snapshotId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && incoming().actualPct is number && incoming().plannedPct is number;
      allow delete: if isAdmin();
    }

    // --- OPERATIONS: procurement & materials, manpower plans, document repository ---
    match /procurement/{id} {
      allow read: if isInternal();
      allow create, update: if isStaff() && isValidId(id) && incoming().id == id;
      allow delete: if isAdmin();
    }
    match /manpower/{id} {
      allow read: if isInternal();
      allow create, update: if isStaff() && isValidId(id) && incoming().id == id;
      allow delete: if isAdmin();
    }
    match /documents/{id} {
      allow read: if isInternal();
      allow create, update: if isStaff() && isValidId(id) && incoming().id == id;
      allow delete: if isAdmin();
    }

    // --- FINANCE: budget & expenses — restricted to System Administrator / Project Manager ---
    match /budget/{id} {
      allow read, write: if isManager();
    }
    match /expenses/{id} {
      allow read, write: if isManager();
    }

    // --- PUBLISHING: internal records prepared for the client portal ---
    match /publications/{id} {
      allow read: if isInternal();
      // Staff create drafts and submit for review; approval, publishing and archiving are manager-only.
      allow create: if isStaff() && isValidId(id) && incoming().id == id && incoming().status in ['draft', 'review'];
      allow update: if (isStaff() && existing().status in ['draft', 'review'] && incoming().status in ['draft', 'review'])
        || isManager();
      allow delete: if isAdmin();
    }

    // --- EXTERNAL PORTAL: sanitized, PUBLISHED content only ---
    match /portal/{id} {
      allow read: if isInternal() || isExternal();
      allow write: if isManager();
    }

    // --- CALENDAR: manually added entries (inspections, site visits, deliveries, handover) ---
    match /events/{id} {
      allow read: if isInternal();
      allow create, update: if isManager() && isValidId(id) && incoming().id == id
        && incoming().date is string && incoming().title is string;
      allow delete: if isManager();
    }

    // --- PER-USER NOTIFICATION STATE: read keys + preferences, own document only ---
    match /userPrefs/{uid} {
      allow read: if isCurrentUser(uid) && isInternal();
      allow create, update: if isCurrentUser(uid) && isInternal()
        && incoming().readKeys is list && incoming().readKeys.size() <= 1000;
    }

    // --- AUDIT LOGS ---
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
